module readserial_property_suite(reset_n, clk, rxd, data, valid, cnt_s, cnt_en, state_s);

input reset_n;
input clk;
input rxd;
input [7:0] data;
input valid;

input cnt_s;
input cnt_en;
input state_s;
//i dont need data_i as that is assigned to data in the design

parameter IDLE = 0;
parameter READ_DATA = 1;

`include "tidal.sv"

`begin_tda(ops)



property reset;
t ##0 !reset_n 
implies
t ##1 (state_s == IDLE) and
t ##1 !cnt_s;
endproperty

property stay_in_idle;
t ##0 (state_s == IDLE) and 
t ##0 rxd
implies
t ##1 (state_s == IDLE);

endproperty

property read_byte;
t ##0 (state_s == IDLE) and
t ##0 (!rxd)
 implies
t ##9 valid and
t ##9 (state_s == IDLE); //9 because first 1 start bit, then 8 bits
endproperty


//assertions
a_reset: assert property(@(posedge clk) reset); //this should check for reset. reset_n is active low
a_stay_in_idle: assert property(@(posedge clk) disable iff (!reset_n) stay_in_idle);
a_read_byte: assert property(@(posedge clk) disable iff (!reset_n) read_byte);

`end_tda

endmodule


bind readserial readserial_property_suite inst_readserial_property_suite(.*);