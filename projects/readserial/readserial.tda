module readserial_property_suite(reset_n, clk, rxd, data, valid, cnt_en, count, state_s);

input reset_n;
input clk;
input rxd;
input [7:0] data;
input valid;

//input shortint unsigned cnt_s;
input cnt_en;
input [4:0] count;
input state_s;
//i dont need data_i as that is assigned to data in the design

parameter IDLE = 0;
parameter READ_DATA = 1;

`include "tidal.sv"

`begin_tda(ops)


//a reset_sequence has to be defined explicitly 
//implies is not allowed, use |=>
//drop the t ##0 before reset_sequence
 
sequence reset_sequence;
reset_n == 1'b0;
endsequence;

property reset;
reset_sequence |=>
t ##0 (state_s == IDLE) and
t ##0 !count and
t ##0 !valid;
endproperty;

property reset_old;
t ##0 !reset_n
implies
t ##1 (state_s == IDLE) and
t ##1 !count and
t ##1 !valid;
endproperty

property stay_in_idle;
t ##0 (state_s == IDLE) and 
t ##0 rxd
implies
t ##1 (state_s == IDLE) and
t ##1 !valid;
endproperty



property read_byte_debug;
t ##0 (state_s == IDLE) and
t ##0 (!rxd)
and t ##0 in_idle_counter_is_0
and t ##0 in_idle_counter_not_enabled 
implies
t ##1 (state_s == READ_DATA) and
t ##1 (count == 0) and
t ##2 (state_s == READ_DATA) and
t ##2 (count == 1) and
t ##3 (state_s == READ_DATA) and
t ##3 (count == 2) and
t ##4 (state_s == READ_DATA) and
t ##4 (count == 3) and
t ##5 (state_s == READ_DATA) and
t ##5 (count == 4) and
t ##6 (state_s == READ_DATA) and
t ##6 (count == 5) and
t ##7 (state_s == READ_DATA) and
t ##7 (count == 6) and
t ##8 (state_s == READ_DATA) and
t ##8 (count == 7) and
t ##9 (state_s == IDLE) and
t ##9 valid and
t ##9 !cnt_en;
endproperty


property read_byte_old;
t ##0 (state_s == IDLE) and
t ##0 (!rxd) 
and t ##0 in_idle_counter_is_0 
and t ##0 in_idle_counter_not_enabled 
//and t ##9 (rxd) //whether it starts on another byte or not
implies
t ##9 valid and
t ##9 (state_s == IDLE); //9 because first 1 start bit, then 8 bits
endproperty

property read_byte;
t ##0 (state_s == IDLE) and
t ##0 !rxd
//and t ##0 in_idle_counter_is_0
//and t ##0 in_idle_counter_not_enabled 
implies
//also check that valid is zero 8 times in a row
t ##1 !valid [*8] and
t ##9 valid and
t ##9 (state_s == IDLE) and
//this is how to check that data values to match with rxd line
t ##9 data == {
$past(rxd, 8),
$past(rxd, 7),
$past(rxd, 6),
$past(rxd, 5),
$past(rxd, 4),
$past(rxd, 3),
$past(rxd, 2),
$past(rxd, 1)};
endproperty


//reachability constriants
//don't use t ##n in sequences, as double t ##n t##n from both sequence and property gives error
sequence in_idle_counter_is_0;
(state_s == IDLE) and !count;
endsequence

sequence in_idle_counter_not_enabled;
(state_s == IDLE) and !cnt_en;
endsequence

//
property in_idle_counter_not_enabled_base;
t ##0 !reset_n
implies
t ##1 in_idle_counter_not_enabled;
endproperty

property in_idle_counter_not_enabled_step;
t ##0 in_idle_counter_not_enabled and
t ##1 state_s == IDLE
implies
t ##1 in_idle_counter_not_enabled;
endproperty


//
property in_idle_counter_is_0_base;
t ##0 !reset_n 
implies
t ##1 in_idle_counter_is_0;
endproperty


property in_idle_counter_is_0_step;
t ##0 in_idle_counter_is_0 and
t ##1 state_s == IDLE
implies
t ##1 in_idle_counter_is_0;
endproperty




//assertions
a_reset: assert property(@(posedge clk) reset); //this should check for reset. reset_n is active low
a_stay_in_idle: assert property(@(posedge clk) disable iff (!reset_n) stay_in_idle);
a_read_byte: assert property(@(posedge clk) disable iff (!reset_n) read_byte);
a_read_byte_debug: assert property(@(posedge clk) disable iff (!reset_n) read_byte_debug);

//checking validity of reachability constraints
a_in_idle_counter_is_0_base: assert property(@(posedge clk) in_idle_counter_is_0_base);
a_in_idle_counter_is_0_step: assert property(@(posedge clk) disable iff(!reset_n) in_idle_counter_is_0_step);
a_in_idle_counter_not_enabled_base: assert property(@(posedge clk) in_idle_counter_not_enabled_base);
a_in_idle_counter_not_enabled_step: assert property(@(posedge clk) disable iff (!reset_n) in_idle_counter_not_enabled_step);


`end_tda

endmodule


bind readserial readserial_property_suite inst_readserial_property_suite(.*);