module readserial_property_suite(reset_n, clk, rxd, data, valid);

input reset_n;
input clk;
input rxd;
input [7:0] data;
input valid;


`include "tidal.sv"

`begin_tda(ops)

//`begin_sva(ops)
//sequence reset_sequence;
//reset_n == 1'b0;
//endsequence;
//`end_sva

property reset;
t ##0 reset_n implies
t ##1 valid;
endproperty

property stay_in_idle;
t ##0 valid implies
t ##1 rxd;
endproperty

property read_byte;
t ##0 valid implies
t ##1 rxd;
endproperty


//assertions
a_reset: assert property(@(posedge clk) disable iff (reset_n) reset);
a_stay_in_idle: assert property(@(posedge clk) disable iff (reset_n) stay_in_idle);
a_read_byte: assert property(@(posedge clk) disable iff (reset_n) read_byte);

`end_tda

endmodule


bind readserial readserial_property_suite inst_readserial_property_suite(.*);